---
import { getEntry } from 'astro:content';

interface Props {
  id: string;
}

const { id } = Astro.props;
const fact = await getEntry('facts', id);
if (!fact) {
  throw new Error(`Fact 组件引用了不存在的事实 ID：${id}`);
}
const verifiedDate = fact.data.verifiedAt
  ? new Date(fact.data.verifiedAt).toISOString().slice(0, 10)
  : null;
---

<div class="wbl-fact not-content">
  <svg class="wbl-fact-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <circle cx="8" cy="8" r="6.2" stroke="#8A6D1F" stroke-width="1.4" />
    <path d="M8 4.8V8.4l2.2 1.4" stroke="#8A6D1F" stroke-width="1.4" stroke-linecap="round" />
  </svg>
  <div class="wbl-fact-body">
    <div class="wbl-fact-head">
      <strong class="wbl-fact-label">会变的事实</strong>
      {fact.data.status === 'pending' && <span class="wbl-fact-pending">待核对</span>}
      {verifiedDate && <span class="wbl-fact-date">核对于 {verifiedDate}</span>}
    </div>
    <p class="wbl-fact-text">{fact.data.text}</p>
  </div>
</div>

<style>
  .wbl-fact {
    margin: 20px 0 24px;
    padding: 14px 16px;
    border-radius: 12px;
    background: #fafaf7;
    border: 1px dashed #d6d3c4;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 14.5px;
    line-height: 1.7;
    color: #4a4f57;
  }

  .wbl-fact-icon {
    flex: none;
    margin-top: 4px;
  }

  .wbl-fact-body {
    flex: 1;
    min-width: 0;
  }

  .wbl-fact-head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 4px;
  }

  .wbl-fact-label {
    color: #111318;
    font-size: 13.5px;
    font-weight: 600;
  }

  .wbl-fact-pending {
    font-size: 11px;
    font-weight: 600;
    color: #9a3412;
    background: #fff6ef;
    border: 1px solid #f6d7c2;
    border-radius: 6px;
    padding: 1px 6px;
  }

  .wbl-fact-date {
    font-family: var(--font-mono);
    font-size: 12px;
    color: #6b7079;
  }

  .wbl-fact-text {
    margin: 0;
  }
</style>
