---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div class="wbl-warning not-content">
  <div class="wbl-warning-head">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M8 2.2 14.2 13H1.8L8 2.2Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
      <path d="M8 6.4v3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
      <circle cx="8" cy="11.2" r="0.8" fill="currentColor" />
    </svg>
    <span>{title}</span>
  </div>
  <div class="wbl-warning-body">
    <slot />
  </div>
</div>

<style>
  .wbl-warning {
    margin: 22px 0 26px;
    padding: 18px 20px;
    border-radius: 12px;
    background: #fff6ef;
    border: 1px solid #f6d7c2;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .wbl-warning-head {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 700;
    color: #9a3412;
  }

  .wbl-warning-body {
    font-size: 15px;
    line-height: 1.8;
    color: #2b2f36;
  }

  .wbl-warning-body :global(p) {
    margin: 0 0 8px;
  }

  .wbl-warning-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .wbl-warning-body :global(ul),
  .wbl-warning-body :global(ol) {
    margin: 0;
    padding-left: 20px;
  }

  .wbl-warning-body :global(li + li) {
    margin-top: 6px;
  }
</style>
