---
// 首页首屏产品预览：左 100% 还原 WorkBuddy 5.11.3 无遮罩活界面 + 右 泊舟陪练栏（纯 HTML/CSS/SVG，零 React）
import { SITE } from '../site.config.mjs';
---

<div class="rounded-2xl border border-[#e2e2de] bg-[#fafaf9] shadow-[0_1px_2px_rgba(17,19,24,0.04),0_24px_64px_-24px_rgba(17,19,24,0.18)] overflow-hidden">
  <!-- 顶部导览条 -->
  <div class="h-11 border-b border-[#e6e6e3] bg-white px-4 flex items-center justify-between gap-3">
    <div class="flex items-center gap-3">
      <span class="inline-flex items-center gap-1.5 text-[13px] font-bold text-gray-900">
        <svg width="18" height="18" viewBox="0 0 64 64" fill="none" aria-hidden="true">
          <path d="M9 52H23V38H37V24" stroke="#111318" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
          <circle cx="50" cy="15" r="7" fill="#3355E0" />
        </svg>
        WorkBuddy <span class="text-gray-500 font-medium">Lab</span>
      </span>
      <span class="inline-flex items-center gap-1 bg-gray-100 p-0.5 rounded-lg text-[11.5px]">
        <span class="bg-white text-gray-900 font-semibold px-2.5 py-0.5 rounded-md shadow-2xs">0.4 认识界面</span>
        <span class="text-gray-500 px-2 py-0.5">1.4 个性化</span>
        <span class="text-gray-500 px-2 py-0.5">2.2 模式</span>
      </span>
    </div>
    <span class="text-[11.5px] text-gray-500 border border-[#e6e6e3] rounded-full px-2.5 py-0.5">
      {SITE.simulatorBadge}
    </span>
  </div>

  <!-- 主舞台：左 5.11.3 无遮罩活界面 + 右 泊舟陪练栏 -->
  <div class="flex gap-3 p-3 h-[548px] select-none">
    <!-- 左：100% 还原 WorkBuddy 5.11.3 窗口（无黑遮罩！） -->
    <div class="flex-1 min-w-0 flex rounded-[14px] border border-[#e6e6e3] bg-white overflow-hidden">
      <!-- 侧栏 -->
      <aside class="w-[206px] shrink-0 bg-[#f7f7f7] border-r border-[#ebebeb] flex flex-col text-[12.5px]">
        <div class="h-9 px-3 flex items-center justify-between">
          <div class="flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-[#ff5f57]"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#febc2e]"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#28c840]"></span>
          </div>
          <span class="text-[#8c9099] text-[11px]">◫ ⌕ ▽</span>
        </div>
        <div class="px-3 pb-2.5 flex items-center justify-between gap-1">
          <span class="font-bold text-[13px] text-[#111318]">
            WorkBuddy <span class="text-[9.5px] text-[#8c9099] font-mono font-normal">5.11.3</span>
          </span>
          <span class="text-[10px] text-[#5c5f66] bg-[#efefef] rounded-full px-1.5 py-0.5">发现应用 ∨</span>
        </div>
        <div class="px-2 flex flex-col gap-0.5 text-[#2b2f36]">
          <div class="px-2.5 py-1.5 rounded-lg bg-[#eaeae8] font-medium text-[#111318]">⊕ 新建任务</div>
          <div class="px-2.5 py-1.5 rounded-lg">助理 <span class="text-[9px] text-[#8c9099] border border-[#dadad7] rounded-full px-1 ml-1">BETA</span></div>
          <div class="px-2.5 py-1.5 rounded-lg">专家·技能·连接器</div>
          <div class="px-2.5 py-1.5 rounded-lg">定时任务</div>
          <div class="px-2.5 py-1.5 rounded-lg">资料库</div>
          <div class="px-2.5 py-1.5 rounded-lg">发现</div>
        </div>
        <div class="px-4 pt-4 pb-1 text-[10.5px] text-[#8c9099]">分组</div>
        <div class="px-4 py-1 text-[12px] text-[#4a4f57]">WorkBuddy-练习</div>
        <div class="flex-1"></div>
        <div class="px-3 py-2 border-t border-[#ebebeb] flex items-center justify-between text-[#5c5f66]">
          <span class="flex items-center gap-1.5">
            <span class="w-5 h-5 rounded-full bg-[#e3e7f3] text-accent-600 text-[10px] font-semibold inline-flex items-center justify-center">学</span>
            <span class="text-[12px] text-[#1f2329] font-medium">学员</span>
          </span>
          <span class="text-[11px]">🔔 ❏</span>
        </div>
      </aside>

      <!-- 主区 -->
      <div class="flex-1 min-w-0 relative flex flex-col items-center justify-center px-6 pb-5">
        <div class="text-[24px] font-bold tracking-[-0.02em] text-[#111318] mb-4">WorkBuddy，我帮你</div>
        <div class="flex gap-1.5 flex-wrap justify-center text-[11px] text-[#3a3e45] mb-3.5">
          {['创作文档', '分析数据', '代码开发', 'UI/UX', '制作PPT'].map((tag) => (
            <span class="px-2.5 py-1 rounded-full border border-[#ebebeb] bg-[#fafafa]">{tag}</span>
          ))}
        </div>

        <!-- 双层底座输入框 + 真实向上弹出的分组菜单 + 蓝圈指引 -->
        <div class="relative w-full max-w-[520px]">
          <!-- 真实弹出的 5.11.3 分组下拉菜单 -->
          <div class="absolute left-1 bottom-[42px] z-20 w-[200px] rounded-[12px] bg-white border border-[#e6e6e3] shadow-[0_14px_34px_rgba(17,19,24,0.14)] p-1.5 text-[12px]">
            <div class="px-2 py-1 rounded-md bg-[#f5f5f5] text-[#8c9099] text-[11px] mb-1">⌕ 搜索分组</div>
            <div class="px-2 py-1.5 rounded-md bg-[#eef2ff] text-accent-600 font-medium">📁 WorkBuddy-练习</div>
            <div class="px-2 py-1.5 rounded-md text-[#4a4f57]">📁 01_会议纪要</div>
            <div class="h-px bg-[#eeeeeb] my-1"></div>
            <div class="px-2 py-1 text-[#5c5f66]">＋ 新建分组</div>
          </div>

          <div class="rounded-[20px] bg-[#f4f4f5] p-[1px]">
            <div class="rounded-[18px] bg-white border border-[#e6e6e6] px-3.5 pt-3 pb-2.5">
              <div class="min-h-[42px] text-[13px] text-[#4a4f57] leading-[1.6]">
                <span id="hero-typewriter">今天帮你做些什么？@ 添加上下文，/调用技能与指令</span><span class="wbl-caret" aria-hidden="true"></span>
              </div>
              <div class="flex items-center justify-between pt-1.5">
                <span class="w-7 h-7 rounded-lg inline-flex items-center justify-center text-[#2b2f36] text-[17px]">+</span>
                <div class="flex items-center gap-2.5 text-[11.5px] text-[#2b2f36]">
                  <span class="font-medium">Hy4 flash ∨</span>
                  <span class="w-7 h-7 rounded-full bg-[#c9ccd1] inline-flex items-center justify-center text-white text-[11px]">▲</span>
                </div>
              </div>
            </div>
            <div class="h-9 px-3.5 flex items-center gap-4 text-[12px]">
              <span class="sim-ring relative inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md text-[#111318] font-medium">
                📁 选择分组 ∧
              </span>
              <span class="text-[#5c5f66]">🛡 默认权限 ∨</span>
            </div>
          </div>
        </div>

        <div class="w-full max-w-[520px] mt-4 flex flex-col items-start gap-1.5 text-[11.5px] text-[#4a4f57]">
          <span class="px-3 py-1.5 rounded-full border border-[#ececea] bg-white">第一次用 AI 办公，可以先做哪 3 件事 ↗</span>
          <span class="px-3 py-1.5 rounded-full border border-[#ececea] bg-white">把杂乱群聊整理成一份待办清单 ↗</span>
        </div>
      </div>
    </div>

    <!-- 右：泊舟陪练栏（带真人头像 + 4 段进度 + 实时清单） -->
    <aside class="w-[332px] shrink-0 rounded-[14px] border border-[#e6e6e3] bg-white flex flex-col overflow-hidden">
      <div class="px-3.5 pt-3 pb-2.5 border-b border-[#eeeeeb]">
        <div class="flex items-center gap-2.5">
          <img
            src="/avatar-bozhou.jpg"
            alt="泊舟头像"
            width="36"
            height="36"
            class="w-9 h-9 rounded-full object-cover border border-black/10 shrink-0"
          />
          <div class="min-w-0">
            <div class="flex items-center gap-1.5">
              <span class="font-bold text-[14px] text-gray-900">泊舟</span>
              <span class="text-[10.5px] font-medium text-accent-600 bg-accent-50 border border-accent-200 rounded-full px-1.5">陪练教练</span>
            </div>
            <div class="text-[11px] text-gray-500 truncate">左边哪里都能点，点了我会告诉你那是什么</div>
          </div>
        </div>
        <div class="grid grid-cols-4 gap-1 mt-2.5 text-[11px] text-center">
          <span class="py-0.5 rounded bg-gray-100 text-gray-700">是什么</span>
          <span class="py-0.5 rounded bg-gray-900 text-white font-semibold">动手</span>
          <span class="py-0.5 rounded bg-gray-100 text-gray-500">看结果</span>
          <span class="py-0.5 rounded bg-gray-100 text-gray-500">记住</span>
        </div>
      </div>

      <div class="flex-1 p-3.5 flex flex-col gap-2 text-[12.5px] overflow-hidden">
        <div class="self-end text-[11px] text-gray-500">你点了「选择分组」</div>
        <div class="flex items-start gap-2">
          <img src="/avatar-bozhou.jpg" alt="" width="22" height="22" class="w-5.5 h-5.5 rounded-full object-cover shrink-0 mt-0.5" />
          <div class="rounded-[4px_12px_12px_12px] bg-gray-100 px-3 py-2 leading-[1.65] text-gray-900">
            <strong>新手第一个坑就在这</strong>：一个分组就是本地一个项目文件夹。不选分组直接发任务，文件生成完很容易找不到。
          </div>
        </div>

        <div class="rounded-[10px] border border-[#e6e6e3] bg-white overflow-hidden mt-1">
          <div class="px-2.5 py-1.5 bg-[#fbfbfa] border-b border-[#eeeeeb] flex justify-between text-[11px]">
            <span class="font-semibold text-gray-900">首页 6 块核心区</span>
            <span class="font-mono text-accent-600 font-semibold">已认 5 / 6</span>
          </div>
          <div class="px-2.5 py-1.5 flex items-center justify-between text-[12px] border-b border-[#f2f2ef] text-gray-500">
            <span class="line-through">选择分组</span>
            <span class="w-4 h-4 rounded-full bg-accent-600 text-white text-[10px] inline-flex items-center justify-center">✓</span>
          </div>
          <div class="px-2.5 py-1.5 flex items-center justify-between text-[12px] bg-accent-50/70 text-gray-900 font-medium">
            <span>默认权限</span>
            <span class="text-[10.5px] text-accent-600 bg-white border border-accent-200 rounded-full px-1.5">去点左边</span>
          </div>
        </div>
      </div>

      <div class="px-3.5 py-2.5 border-t border-[#eeeeeb] bg-[#fbfbfa] flex items-center justify-between gap-2">
        <span class="text-[11.5px] text-gray-500">全程无遮罩 · 自由探索</span>
        <a
          href="/simulator/?route=interface"
          class="group wbl-btn-spring inline-flex items-center gap-1 h-8 px-3 rounded-lg bg-gray-900 text-white text-[12px] font-semibold no-underline hover:bg-[#2a2d35]"
        >
          <span>进入泊舟陪练</span>
          <span class="wbl-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </aside>
  </div>
</div>
